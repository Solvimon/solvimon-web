# GUI git clients (Fork, GitKraken, etc.) don't load the user's shell profile,
# so nvm-managed node isn't on PATH. Source nvm explicitly to fix this.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Lints and formats staged files only. Set SKIP_LINT_STAGED=1 to bypass.
# --no-stash keeps lint-staged's backup out of the stash list every worktree shares. Without that
# backup it does not put back the unstaged hunks of partially staged files when a task fails, so
# they are re-applied here from the patch it set them aside in.
if [ "$SKIP_LINT_STAGED" != "1" ]; then
    patch="$(git rev-parse --git-path lint-staged_unstaged.patch)"
    if [ -s "$patch" ]; then
        kept="$patch.$(date +%s)"
        mv "$patch" "$kept"
        echo "lint-staged left unrestored changes from an earlier commit; they are in $kept" >&2
    fi

    status=0
    ./node_modules/.bin/lint-staged --no-stash || status=$?

    if [ "$status" -ne 0 ] && [ -s "$patch" ]; then
        if git apply --check --reverse "$patch" 2>/dev/null; then
            : # already back in the working tree
        elif ! git apply --whitespace=nowarn "$patch"; then
            kept="$patch.$(date +%s)"
            mv "$patch" "$kept"
            echo "Could not restore your unstaged changes; they are in $kept" >&2
        fi
    fi
    rm -f "$patch"
    exit "$status"
fi
