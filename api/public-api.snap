    data: T[];
    page: number;
    limit: number;
    total_number_of_pages?: number;
    links: {
        previous?: string;
        current: string;
        next?: string;
    };
};
export type ApiResponse<T> = ApiErrorResponse | ApiSuccessResponse<T>;
export type ApiCollectionResponse<T> = ApiErrorResponse | ApiSuccessCollectionResponse<T>;
export type SearchField<T extends string> = {
    name: T;
    value: string;
    wildcard_start?: boolean;
    wildcard_end?: boolean;
    ignore_case?: boolean;
};
export type ApiSearchFields<T extends string> = {
    name: T;
    value: string;
    wildcard_start: boolean;
    wildcard_end: boolean;
    ignore_case: boolean;
};
export type FilterField<T extends string> = {
    name: T;
    reference?: string;
    value?: string;
} | {
    name: T;
    reference?: string;
    values?: string[];
};
export type Pagination<OrderBy extends string> = {
    orderBy?: OrderBy;
    orderDirection?: 'asc' | 'desc';
    page?: number;
    pageSize?: number;
};

