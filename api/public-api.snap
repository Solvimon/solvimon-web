}
/**
 * The display-safe view of a pending authorization request. The authorization
 * server deliberately withholds `redirect_uri` and `code_challenge` here, so
 * the consent screen cannot build the return redirect itself — approving and
 * denying both go back to the server for it.
 */
export interface OAuthAuthorizationRequest {
