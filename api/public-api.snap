// types/vendor/@solvimon/solvimon-types/types/IndexingSettings.d.ts
/**
 * How an indexed price is rounded after the percentage is applied.
 *
 * PRESERVE_SCALE rounds half-up to the same number of decimals as the
 * original price. For example 9.99 indexed with 50% gives 14.985, which
 * becomes 14.99 because the original price had 2 decimals.
 *
 * DECIMALS rounds half-up to the number of decimals given in
 * number_of_decimals. The same example with 3 decimals stays 14.985.
 */
export type IndexingRoundingMode = 'PRESERVE_SCALE' | 'DECIMALS';
export interface IndexingSettings {
    /** Stringified decimal. A negative percentage decreases the prices. */
    percentage: string;
    /** Mandatory whenever indexing_settings is sent. */
    rounding_mode: IndexingRoundingMode;
    /** Required when rounding_mode is DECIMALS. */
    number_of_decimals?: number;
}
export interface IndexedEntity {
    /** A pricing, pricing item or pricing item config id. */
    id: string;
    indexing_settings: IndexingSettings;
}

