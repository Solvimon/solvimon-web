    payment_method_id?: string | null;
    preview?: boolean | null;
}
/**
 * `GET /pricing-plan-schedules/{id}/on-demand-pricing-items`: the schedule's pricing, narrowed by
 * the backend to One Off items whose `configs` hold an `on_demand` config priced FIXED, FLAT or
 * FLEXIBLE. A One Off item has at most one config in `configs`, so each listed item carries a single
 * config. Items priced per currency or billing period keep their configs in
 * `pricing_currency_configs` or `billing_period_configs`, which this endpoint does not read, so they
 * are not listed. Configs with `wallet_grants` are kept.
