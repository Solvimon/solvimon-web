}
export interface ApprovalRequest extends ApprovalRequestPayload {
    object_type: 'APPROVAL_REQUEST';
    id: string;
    owner_id: string;
    source_id: string;
    source_type: ApprovalPolicySourceType;
    /** Present when the request is fetched with `expand[]=approval_policy_ids`. */
    approval_policies?: ApprovalPolicy[];
    approval_strategy?: ApprovalPolicyApprover['type'];
}
/** Body of the bulk `POST /approval-requests/{approve,decline,cancel}` actions. */
export interface BulkApprovalRequestActionPayload {
    resource_ids: ApprovalRequest['id'][];
}
/**
 * One item of a bulk approval-request action's response. The call itself succeeds even when items
 * fail, so every item has to be checked.
 */
export type BulkApprovalRequestResult = {
    resource_id: ApprovalRequest['id'];
    status: 'SUCCEEDED';
    approval_request: ApprovalRequest;
} | {
    resource_id: ApprovalRequest['id'];
    status: 'FAILED';
    error: ApiErrorResponse;
};

