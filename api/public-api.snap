// types/public/types/index.d.ts
/**
 * Types the SDK declares itself rather than taking from a package it depends on.
 *
 * `@solvimon/solvimon-types` needs no entry here: the build vendors its declarations into the
 * published package, so every name in it resolves for a consumer who cannot install it.
 *
 * `@solvimon/solvimon-ui` cannot be vendored the same way — its declarations reach `@vuelidate/core`,
 * `vue-router`, `@tiptap/core` and five more packages this one does not depend on, so bringing them
 * along would trade one unresolvable import for eight. Only `IntlMessages` is on the surface a host
 * writes, and it is a single line, so it is declared here and checked against the original in
 * `publicContract.spec.ts`.
 */
/** Translation overrides, keyed by message id. */
export type IntlMessages = Record<string, string>;
/**
 * The environments the published package supports.
 *
 * Narrowed from the union in `@solvimon/solvimon-types` with `Extract` rather than restated, so a
 * rename upstream is a compile error here instead of a surface that quietly drifts. The remaining
 * environments are development infrastructure and are stripped from the published build; see
 * `src/config/internalEnvironments.ts`.
 */
export type { PublicEnvironment as Environment } from '../../config/types';

// types/translations/supported.d.ts
export const SUPPORTED_LOCALES: readonly ["en-US", "nl-NL", "de-DE", "it-IT", "fr-FR"];

// types/types/EntryBaseProps.d.ts
import { PortalUrl } from '../vendor/@solvimon/solvimon-types/index';
import { SolvimonBranding } from './branding';
import { ProviderProps } from '../components/providers/Provider/Provider.types';
/**
 * The properties every element takes: those `EntryProvider` reads from it. Picked rather than
 * omitted, so a prop added to the provider stack does not become element surface by accident.
 */
export type EntryBaseProps<PortalObjectType extends PortalUrl> = Pick<ProviderProps, 'environment' | 'locale' | 'dateLocale' | 'messages' | 'portalToken' | 'experimentalFeatures' | 'logLevel' | 'onLog' | 'cssOverrides'> & {
    /**
     * The colours every element is drawn in, and the emblem screens show as their avatar.
     */
    branding?: SolvimonBranding;
    portalObject: PortalObjectType;
};

// types/types/branding.d.ts
/**
 * The branding an element is shown in. The platform branding the API returns fits it as it is, so
 * a host can pass that on without picking fields out; like the API, it takes `null` for unset.
 */
export interface SolvimonBranding {
    /** The brand's colours, for the buttons, links and highlights of every element. */
    colors?: {
        primary?: string | null;
        secondary?: string | null;
    };
    /** Shown as the avatar where a screen has one: the checkout's order summary, a subscription. */
    emblem?: {
        public_url?: string | null;
    };
}

// types/types/portalAuthentication.d.ts
/** How a portal object signs in: an identity token, or the handle a `SIGNED_TOKEN` link carries. */
export type PortalAuthentication = 'IDENTITY_TOKEN' | 'SIGNED_TOKEN';

// types/types/portalToken.d.ts
/** The answer to `POST /portal/token`, which exchanges the handle of a `SIGNED_TOKEN` link. */
export interface PortalToken {
    issued_at: string;
    access_token: string;
    /** Seconds until the link expires: the token lives as long as the link. */
    access_token_expires_in: number;
    access_token_expires_at: string;
    token_type: 'bearer';
}

// types/vendor/@adyen/adyen-web/index.d.ts
export type ResultCode = 'AuthenticationFinished' | 'AuthenticationNotRequired' | 'Authorised' | 'Cancelled' | 'ChallengeShopper' | 'Error' | 'IdentifyShopper' | 'PartiallyAuthorised' | 'Pending' | 'PresentToShopper' | 'Received' | 'RedirectShopper' | 'Refused';
export type PaymentActionsType = 'redirect' | 'threeDS2' | 'voucher' | 'qrCode' | 'await' | 'bankTransfer' | 'sdk';

