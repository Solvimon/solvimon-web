import type { ApiErrorResponse } from './Api';
import type { ApprovalPolicy, ApprovalPolicyApprover, ApprovalPolicySourceType } from './ApprovalPolicies';
export type ApprovalRequestStatus = 'PENDING_REVIEW' | 'APPROVED' | 'DECLINED' | 'CANCELLED';
export type ApprovalRequestReviewer = {
    id: string;
    status: ApprovalRequestStatus;
    reviewed_at: string;
    level: number;
};
export interface ApprovalRequestPayload {
