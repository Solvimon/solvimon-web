// types/vendor/@solvimon/solvimon-types/types/ApprovalPolicies.d.ts
import type { Amount } from './Amount';
import type { ResourceStatus } from './ResourceStatus';
export interface ApprovalPolicyBaseRule {
    type: 'DISCOUNT' | 'COMMITMENT' | 'PRICING' | 'CUSTOM_FIELD' | 'ALWAYS_APPROVE';
    comparator?: 'LESS_THAN' | 'LESS_THAN_OR_EQUALS' | 'EQUALS' | 'GREATER_THAN_OR_EQUALS' | 'GREATER_THAN';
}
export interface ApprovalPolicyDiscountRule extends ApprovalPolicyBaseRule {
    type: 'DISCOUNT';
    discount: {
        percentage: string;
    } | {
        amount: Amount;
    };
}
export interface ApprovalPolicyCommitmentRule extends ApprovalPolicyBaseRule {
    type: 'COMMITMENT';
    commitment: {
        amount: Amount;
    };
}
export interface ApprovalPolicyPricingRule extends ApprovalPolicyBaseRule {
    type: 'PRICING';
    pricing: {
        has_override: boolean;
    };
}
export interface ApprovalPolicyCustomFieldRule extends ApprovalPolicyBaseRule {
    type: 'CUSTOM_FIELD';
    custom_field: {
        id: string;
        value: string;
    };
}
export interface ApprovalPolicyAlwaysApproveRule extends ApprovalPolicyBaseRule {
    type: 'ALWAYS_APPROVE';
}
export type ApprovalPolicyRule = ApprovalPolicyCommitmentRule | ApprovalPolicyCustomFieldRule | ApprovalPolicyDiscountRule | ApprovalPolicyPricingRule | ApprovalPolicyAlwaysApproveRule;
export type ApprovalPolicyRuleGroup = {
    rules: ApprovalPolicyRule[];
};
export type ApprovalPolicyUserGroup = {
    level: number;
    approvers: {
        type: 'USER';
        user: {
            id: string;
        };
    }[];
};
type ApprovalPolicyApproverUser = {
    type: 'ALL_LEVELS_MUST_APPROVE' | 'HIGHER_LEVEL_CAN_OVERRIDE' | 'ANYONE_CAN_DECIDE';
    approval_groups: ApprovalPolicyUserGroup[];
};
type ApprovalPolicyApprovalType = 'GROUP' | 'LEVEL';
export type ApprovalPolicyApprover = ApprovalPolicyApproverUser;
export type ApprovalPolicySourceType = 'INVOICE' | 'QUOTE_VERSION' | 'PRICING_PLAN_SCHEDULE';
export type ApprovalPolicyStatus = 'DRAFT' | 'ACTIVE' | 'DEPRECATED' | 'ARCHIVED';
export type ApprovalPolicyCreateStatus = Extract<ApprovalPolicyStatus, 'DRAFT' | 'ACTIVE'>;
export interface ApprovalPolicyPayload {
    name: string;
    reference: string;
    approval_type: ApprovalPolicyApprovalType;
    approvers: ApprovalPolicyApproverUser;
    rule_groups: ApprovalPolicyRuleGroup[];
    source_type: ApprovalPolicySourceType;
}
export interface ApprovalPolicyCreatePayload extends ApprovalPolicyPayload {
    status?: ApprovalPolicyCreateStatus;
}
export interface ApprovalPolicy extends ApprovalPolicyPayload {
    id: string;
    object_type: 'APPROVAL_POLICY';
    created_at: string;
    updated_at: string;
    status: ApprovalPolicyStatus;
}
export type WithApprovalFlow<T extends {
    status: ResourceStatus;
}> = T & {
    status: T['status'] | 'WAITING_APPROVAL' | 'APPROVED' | 'DECLINED';
};
export {};

