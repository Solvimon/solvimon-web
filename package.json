{
    "name": "@solvimon/solvimon-web",
    "version": "0.1.0-alpha.19",
    "description": "Solvimon's Front-end SDK provides you with the building blocks to create a billing self serve experience",
    "private": false,
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "analyze": "vite-bundle-visualizer",
        "prebuild": "npm run build:css && npm run type-check",
        "build": "vite build",
        "build:internal": "SOLVIMON_INTERNAL_ENVIRONMENTS=1 npm run build",
        "build:css": "tailwindcss -i ./src/assets/index.css -o ./.sdk/tailwind.css",
        "dev": "npm run watch",
        "playground:dev": "npm --prefix playground run dev",
        "playground:install": "npm --prefix playground install",
        "playground:link": "node ./scripts/link-local-packages.mjs link",
        "playground:unlink": "node ./scripts/link-local-packages.mjs unlink",
        "lint": "eslint . --fix",
        "lint:ci": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:unit": "vitest",
        "test:coverage": "vitest --run --coverage",
        "type-check:declarations": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.json --composite false",
        "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
        "prewatch": "npm run build:css",
        "watch": "run-p watch:js watch:css",
        "watch:js": "SOLVIMON_INTERNAL_ENVIRONMENTS=1 vite build --watch",
        "watch:css": "npm run build:css -- --watch",
        "translations:extract": "formatjs extract 'src/**/*.{ts,vue}*' --ignore='**/*.d.ts' --out-file 'src/translations/source.json' --flatten --additional-function-names '$t'",
        "translations:compile": "formatjs compile 'src/translations/source.json' --out-file 'src/translations/locales/en-US.json'",
        "translations:check": "node ./scripts/check-translations.mjs",
        "types:check-published": "node ./scripts/ci/check-published-types.mjs",
        "types:check-consumer": "node ./scripts/ci/check-consumer-types.mjs",
        "bundle:check-contents": "node ./scripts/ci/check-bundle-contents.mjs",
        "logs:list": "node ./scripts/list-log-codes.mjs",
        "test:e2e:run-app": "node scripts/start-test-app.mjs",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:ci": "playwright test",
        "test:ssl:generate": "node scripts/generate-ssl-cert.mjs",
        "version:bump": "node scripts/bump-version.mjs",
        "version:patch": "npm version patch --no-git-tag-version",
        "version:minor": "npm version minor --no-git-tag-version",
        "version:major": "npm version major --no-git-tag-version",
        "changelog:check": "node scripts/check-changelog.mjs",
        "publish:guard": "node scripts/publish-guard.mjs",
        "prepublishOnly": "npm run publish:guard && npm run changelog:check && npm run build && npm run bundle:check-contents",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,vue,mjs}": "eslint --fix --max-warnings 0 --no-warn-ignored",
        "*": "prettier --write --ignore-unknown"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs"
        },
        "./core": {
            "types": "./dist/core/index.d.ts",
            "import": "./dist/core/index.mjs",
            "require": "./dist/core/index.cjs"
        },
        "./core/action-request-types": {
            "types": "./dist/core/action-request.types.d.ts"
        },
        "./screens/checkout": {
            "types": "./dist/screens/Checkout/Checkout.ce.d.ts",
            "import": "./dist/screens/Checkout/Checkout.mjs",
            "require": "./dist/screens/Checkout/Checkout.cjs"
        },
        "./screens/customer-overview": {
            "types": "./dist/screens/CustomerOverview/CustomerOverview.ce.d.ts",
            "import": "./dist/screens/CustomerOverview/CustomerOverview.mjs",
            "require": "./dist/screens/CustomerOverview/CustomerOverview.cjs"
        },
        "./screens/subscription-management": {
            "types": "./dist/screens/SubscriptionManagement/SubscriptionManagement.ce.d.ts",
            "import": "./dist/screens/SubscriptionManagement/SubscriptionManagement.mjs",
            "require": "./dist/screens/SubscriptionManagement/SubscriptionManagement.cjs"
        },
        "./screens/subscription-details": {
            "types": "./dist/screens/SubscriptionDetails/SubscriptionDetails.ce.d.ts",
            "import": "./dist/screens/SubscriptionDetails/SubscriptionDetails.mjs",
            "require": "./dist/screens/SubscriptionDetails/SubscriptionDetails.cjs"
        },
        "./screens/pay-invoice": {
            "types": "./dist/screens/PayInvoice/PayInvoice.ce.d.ts",
            "import": "./dist/screens/PayInvoice/PayInvoice.mjs",
            "require": "./dist/screens/PayInvoice/PayInvoice.cjs"
        },
        "./screens/payment-methods-management": {
            "types": "./dist/screens/PaymentMethodsManagement/PaymentMethodsManagement.ce.d.ts",
            "import": "./dist/screens/PaymentMethodsManagement/PaymentMethodsManagement.mjs",
            "require": "./dist/screens/PaymentMethodsManagement/PaymentMethodsManagement.cjs"
        },
        "./components/subscriptions-list": {
            "types": "./dist/components/SubscriptionsList/SubscriptionsList.ce.d.ts",
            "import": "./dist/components/SubscriptionsList/SubscriptionsList.mjs",
            "require": "./dist/components/SubscriptionsList/SubscriptionsList.cjs"
        },
        "./components/customer-payment-methods": {
            "types": "./dist/components/CustomerPaymentMethods/CustomerPaymentMethods.ce.d.ts",
            "import": "./dist/components/CustomerPaymentMethods/CustomerPaymentMethods.mjs",
            "require": "./dist/components/CustomerPaymentMethods/CustomerPaymentMethods.cjs"
        },
        "./components/wallet-balances": {
            "types": "./dist/components/WalletBalances/WalletBalances.ce.d.ts",
            "import": "./dist/components/WalletBalances/WalletBalances.mjs",
            "require": "./dist/components/WalletBalances/WalletBalances.cjs"
        },
        "./components/billing-information": {
            "types": "./dist/components/BillingInformation/BillingInformation.ce.d.ts",
            "import": "./dist/components/BillingInformation/BillingInformation.mjs",
            "require": "./dist/components/BillingInformation/BillingInformation.cjs"
        },
        "./components/billing-information-form": {
            "types": "./dist/components/BillingInformationForm/BillingInformationForm.ce.d.ts",
            "import": "./dist/components/BillingInformationForm/BillingInformationForm.mjs",
            "require": "./dist/components/BillingInformationForm/BillingInformationForm.cjs"
        },
        "./components/invoice": {
            "types": "./dist/components/Invoice/Invoice.ce.d.ts",
            "import": "./dist/components/Invoice/Invoice.mjs",
            "require": "./dist/components/Invoice/Invoice.cjs"
        },
        "./components/invoice-header": {
            "types": "./dist/components/InvoiceHeader/InvoiceHeader.ce.d.ts",
            "import": "./dist/components/InvoiceHeader/InvoiceHeader.mjs",
            "require": "./dist/components/InvoiceHeader/InvoiceHeader.cjs"
        },
        "./components/invoice-details": {
            "types": "./dist/components/InvoiceDetails/InvoiceDetails.ce.d.ts",
            "import": "./dist/components/InvoiceDetails/InvoiceDetails.mjs",
            "require": "./dist/components/InvoiceDetails/InvoiceDetails.cjs"
        },
        "./components/invoices-list": {
            "types": "./dist/components/InvoicesList/InvoicesList.ce.d.ts",
            "import": "./dist/components/InvoicesList/InvoicesList.mjs",
            "require": "./dist/components/InvoicesList/InvoicesList.cjs"
        },
        "./components/payment-history": {
            "types": "./dist/components/PaymentHistory/PaymentHistory.ce.d.ts",
            "import": "./dist/components/PaymentHistory/PaymentHistory.mjs",
            "require": "./dist/components/PaymentHistory/PaymentHistory.cjs"
        },
        "./components/subscription-schedules": {
            "types": "./dist/components/SubscriptionSchedules/SubscriptionSchedules.ce.d.ts",
            "import": "./dist/components/SubscriptionSchedules/SubscriptionSchedules.mjs",
            "require": "./dist/components/SubscriptionSchedules/SubscriptionSchedules.cjs"
        },
        "./components/payment-method-form": {
            "types": "./dist/components/PaymentMethodForm/PaymentMethodForm.ce.d.ts",
            "import": "./dist/components/PaymentMethodForm/PaymentMethodForm.mjs",
            "require": "./dist/components/PaymentMethodForm/PaymentMethodForm.cjs"
        }
    },
    "sideEffects": false,
    "peerDependencies": {
        "vue": ">=3.5.0"
    },
    "dependencies": {
        "@adyen/adyen-web": "^6.14.0",
        "@stripe/stripe-js": "^9.8.0",
        "jwt-decode": "^4.0.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@formatjs/cli": "^6.6.1",
        "@playwright/test": "^1.57.0",
        "@solvimon/solvimon-types": "^1.0.3",
        "@solvimon/solvimon-ui": "^1.7.8",
        "@tsconfig/node22": "^22.0.0",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.10.2",
        "@typescript-eslint/parser": "^8.46.2",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vitest/coverage-v8": "^3.2.4",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.6.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.7.0",
        "@vuelidate/core": "^2.0.3",
        "@vuelidate/validators": "^2.0.4",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.37.0",
        "eslint-import-resolver-typescript": "^3.6.0",
        "eslint-plugin-formatjs": "^6.4.7",
        "eslint-plugin-import-x": "^4.16.1",
        "eslint-plugin-no-relative-import-paths": "^1.5.2",
        "eslint-plugin-unused-imports": "^4.1.4",
        "eslint-plugin-vue": "^9.33.0",
        "glob": "^11.0.1",
        "husky": "^9.1.7",
        "jsdom": "^26.0.0",
        "lint-staged": "^16.4.0",
        "npm-run-all2": "^7.0.2",
        "postcss": "^8.5.23",
        "prettier": "^3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^3.4.17",
        "terser": "^5.46.2",
        "tsx": "^4.22.4",
        "typescript": "~5.6.3",
        "vite": "^6.4.2",
        "vite-plugin-dts": "^4.5.3",
        "vitest": "^3.1.1",
        "vitest-localstorage-mock": "^0.1.2",
        "vue-tsc": "^2.1.10"
    },
    "overrides": {
        "@tiptap/core": "^3.31.2",
        "@tiptap/pm": "^3.31.2",
        "@tiptap/vue-3": "^3.31.2",
        "@tiptap/extensions": "^3.31.2",
        "@tiptap/suggestion": "^3.31.2",
        "@tiptap/extension-collaboration": "^3.31.2",
        "@tiptap/extension-drag-handle": "^3.31.2",
        "@tiptap/extension-drag-handle-vue-3": "^3.31.2",
        "@tiptap/extension-node-range": "^3.31.2",
        "@tiptap/extension-placeholder": "^3.31.2"
    },
    "optionalDependencies": {
        "vite-bundle-visualizer": "^1.2.1"
    }
}
